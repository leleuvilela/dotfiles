{
    "Created": "Phunt_Vieg_",
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "palette": {
        "white":    "#ebdbb2",
        "black":    "#1d2021",
        "blue":     "#83a598",
        "lavender": "#83a598",
        "cyan":     "#8ec07c",
        "green":    "#b8bb26",
        "purple":   "#d3869b",
        "red":      "#fb4934",
        "pink":     "#d3869b",
        "yellow":   "#fabd2f",
        "orange":   "#fe8019"
    },
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "foreground": "p:white",
                    "style": "plain",
                    "template": "\u256d\u2500",
                    "type": "text"
                },
                {
                    "background": "p:yellow",
                    "foreground": "p:black",
                    "leading_diamond": "\ue0b6",
                    "style": "diamond",
                    "template": " {{ .UserName }} ",
                    "trailing_diamond": "\ue0b0",
                    "type": "session"
                },
                {
                    "background": "p:blue",
                    "foreground": "p:black",
                    "properties": {
                        "style": "full"
                    },
                    "style": "diamond",
                    "template": " \uf114  {{ .Path }} ",
                    "trailing_diamond": "\ue0b0",
                    "type": "path"
                },
                {
                    "background": "p:pink",
                    "foreground": "p:black",
                    "properties": {
                        "branch_icon": "",
                        "fetch_stash_count": true,
                        "fetch_status": false,
                        "fetch_upstream_icon": true
                    },
                    "style": "diamond",
                    "template": " \ue725({{ .UpstreamIcon }} {{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }}) ",
                    "trailing_diamond": "\ue0b0",
                    "type": "git"
                },
                {
                    "background": "p:pink",
                    "foreground": "p:black",
                    "properties": {
                        "time_format": "15:04"
                    },
                    "style": "diamond",
                    "template": "{{ if ne (.Segments.Contains \"Git\") true }} \u2665  {{ .CurrentDate | date .Format }} {{ end }}",
                    "trailing_diamond": "\ue0b0",
                    "type": "time"
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "foreground": "p:white",
                    "style": "plain",
                    "template": "\u2570\u2500<p:green>\u26a1</>",
                    "type": "text"
                }
            ]
        }
    ],
    "transient_prompt": {
        "template": "<p:red>\uf489 </><p:blue>\uf0da</><p:pink>\uf105</> "
    },
    "final_space": true,
    "version": 7
}
