# skhdrc — yabai keybinds
#
# Modifier layers:
#   lalt                  focus (spaces, windows, displays)
#   shift + lalt          move (warp windows, send to spaces, mirror)
#   ctrl + lalt           resize / space utils
#   shift + ctrl + lalt   insertion point / scripts
#
# Named spaces (terminal, browser, teams, whatsapp, notes) are labeled by
# ~/dotfiles/scripts/cspaces, which runs from yabairc on every yabai restart.

# ---------------------------------------------------------------------------
# Focus: windows — lalt + {h, j, k, l} (crosses display borders)
# ---------------------------------------------------------------------------
lalt - h : yabai -m window --focus west  || yabai -m display --focus west
lalt - j : yabai -m window --focus south || yabai -m display --focus south
lalt - k : yabai -m window --focus north || yabai -m display --focus north
lalt - l : yabai -m window --focus east  || yabai -m display --focus east || /Users/leleuvilela/dotfiles/scripts/yabai-cycle

# Cycle windows in the current space
lalt - m : /Users/leleuvilela/dotfiles/scripts/yabai-cycle

# ---------------------------------------------------------------------------
# Focus: named spaces
# ---------------------------------------------------------------------------
lalt - return : yabai -m space --focus terminal
lalt - e      : yabai -m space --focus browser
lalt - t      : yabai -m space --focus teams
lalt - w      : yabai -m space --focus whatsapp
lalt - n      : yabai -m space --focus notes

# ---------------------------------------------------------------------------
# Focus: space N on the current display
# ---------------------------------------------------------------------------
lalt - 1 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[1] ]] && yabai -m space --focus $SPACES[1]
lalt - 2 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[2] ]] && yabai -m space --focus $SPACES[2]
lalt - 3 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[3] ]] && yabai -m space --focus $SPACES[3]
lalt - 4 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[4] ]] && yabai -m space --focus $SPACES[4]
lalt - 5 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[5] ]] && yabai -m space --focus $SPACES[5]

# ---------------------------------------------------------------------------
# Window toggles
# ---------------------------------------------------------------------------
# Float / unfloat and center on screen (grid makes the toggle visible)
lalt - space : yabai -m window --toggle float --grid 4:4:1:1:2:2

# Zoom to parent node / fullscreen
lalt - f         : yabai -m window --toggle zoom-parent
shift + lalt - f : yabai -m window --toggle zoom-fullscreen

# ---------------------------------------------------------------------------
# Move: warp windows — shift + lalt + {h, j, k, l}
# (falls back to display, then relative move for floating windows)
# ---------------------------------------------------------------------------
shift + lalt - h : yabai -m window --warp west  || $(yabai -m window --display west  && yabai -m display --focus west && yabai -m window --warp last) || yabai -m window --move rel:-10:0
shift + lalt - j : yabai -m window --warp south || $(yabai -m window --display south && yabai -m display --focus south) || yabai -m window --move rel:0:10
shift + lalt - k : yabai -m window --warp north || $(yabai -m window --display north && yabai -m display --focus north) || yabai -m window --move rel:0:-10
shift + lalt - l : yabai -m window --warp east  || $(yabai -m window --display east  && yabai -m display --focus east && yabai -m window --warp first) || yabai -m window --move rel:10:0

# Toggle split orientation of the selected window node
shift + lalt - s : yabai -m window --toggle split

# ---------------------------------------------------------------------------
# Move: send window to space N on the current display (and follow)
# ---------------------------------------------------------------------------
shift + lalt - 1 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[1] ]] && yabai -m window --space $SPACES[1] && yabai -m space --focus $SPACES[1]
shift + lalt - 2 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[2] ]] && yabai -m window --space $SPACES[2] && yabai -m space --focus $SPACES[2]
shift + lalt - 3 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[3] ]] && yabai -m window --space $SPACES[3] && yabai -m space --focus $SPACES[3]
shift + lalt - 4 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[4] ]] && yabai -m window --space $SPACES[4] && yabai -m space --focus $SPACES[4]
shift + lalt - 5 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[5] ]] && yabai -m window --space $SPACES[5] && yabai -m space --focus $SPACES[5]

# ---------------------------------------------------------------------------
# Move: send window to named space (and follow)
# ---------------------------------------------------------------------------
shift + lalt - return : yabai -m window --space terminal && yabai -m space --focus terminal
shift + lalt - e      : yabai -m window --space browser  && yabai -m space --focus browser
shift + lalt - t      : yabai -m window --space teams    && yabai -m space --focus teams
shift + lalt - w      : yabai -m window --space whatsapp && yabai -m space --focus whatsapp
shift + lalt - n      : yabai -m window --space notes    && yabai -m space --focus notes

# Send window to prev / next space: shift + lalt - { [ , ] }
shift + lalt - 0x21 : yabai -m window --space prev && yabai -m space --focus prev
shift + lalt - 0x1E : yabai -m window --space next && yabai -m space --focus next

# Mirror space on X / Y axis
shift + lalt - x : yabai -m space --mirror x-axis
shift + lalt - y : yabai -m space --mirror y-axis

# ---------------------------------------------------------------------------
# Resize / space utils — ctrl + lalt
# ---------------------------------------------------------------------------
ctrl + lalt - h : yabai -m window --resize right:-100:0 || yabai -m window --resize left:-100:0
ctrl + lalt - j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
ctrl + lalt - k : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
ctrl + lalt - l : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0

# Equalize window sizes
ctrl + lalt - e : yabai -m space --balance

# Toggle gaps / padding in current space
ctrl + lalt - g : yabai -m space --toggle padding; yabai -m space --toggle gap

# ---------------------------------------------------------------------------
# Insertion point / scripts — shift + ctrl + lalt
# ---------------------------------------------------------------------------
shift + ctrl + lalt - h : yabai -m window --insert west
shift + ctrl + lalt - j : yabai -m window --insert south
shift + ctrl + lalt - k : yabai -m window --insert north
shift + ctrl + lalt - l : yabai -m window --insert east
shift + ctrl + lalt - s : yabai -m window --insert stack

# Recreate + relabel spaces
shift + ctrl + lalt - c : /Users/leleuvilela/dotfiles/scripts/cspaces
