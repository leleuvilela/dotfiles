#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(find \
    ~/dotfiles/ \
    ~/dev/ \
    -mindepth 0 -maxdepth 3 -type d | fzf)
fi

if [[ -z $selected ]]; then
  exit 0
fi

selected_name=$(basename "$selected" | tr . _)

use_herdr() {
  [[ -n $HERDR_ENV ]] && return 0
  [[ -n $TMUX ]] && return 1
  command -v herdr >/dev/null 2>&1 || return 1
  herdr workspace list >/dev/null 2>&1
}

if use_herdr; then
  ws_id=$(herdr workspace list 2>/dev/null |
    jq -r --arg label "$selected_name" \
      '(if type=="array" then . else .workspaces end)
         | .[] | select(.label==$label) | .id' |
    head -n1)

  if [[ -n $ws_id ]]; then
    herdr workspace focus "$ws_id"
  else
    herdr workspace create --cwd "$selected" --label "$selected_name" --focus
  fi
  exit 0
fi

tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s "$selected_name" -c "$selected"
  exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux switch-client -t "$selected_name"
